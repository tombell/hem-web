{
  "name": "hem-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm --filter @hem/server start",
    "start:sample": "pnpm --filter @hem/server start:sample",
    "seed:sample": "pnpm --filter @hem/server seed:sample",
    "dev:dashboard": "pnpm --filter @hem/dashboard dev",
    "build": "pnpm --filter @hem/dashboard build",
    "test": "pnpm --recursive test",
    "typecheck": "tsc --noEmit && pnpm --recursive typecheck",
    "fmt": "vp fmt --write .",
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "api:types": "pnpm --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 dlx openapi-typescript packages/server/src/openapi.json -o packages/dashboard/src/api.generated.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
