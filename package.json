{
  "name": "@hem/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "fmt": "vp fmt --write .",
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix .",
    "test": "vp test run",
    "typecheck": "tsc --noEmit && pnpm --filter @hem/dashboard typecheck",
    "build": "pnpm --filter @hem/dashboard build",
    "dev:dashboard": "pnpm --filter @hem/dashboard dev",
    "api:types": "pnpm --package=typescript@5.9.3 --package=openapi-typescript@7.13.0 dlx openapi-typescript src/openapi.json -o packages/dashboard/src/api.generated.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  }
}
