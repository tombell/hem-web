# Deny by default: no repository history, host modules, health data or secrets.
**
!Dockerfile
!.dockerignore
!.gitignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!vite.config.ts
!README.md
# Defense in depth if an allowlist is extended later.
**/node_modules/**
**/.git/**
**/.env
**/.env.*
**/data/**
**/*.sqlite*
**/*.db*
**/*.pem
**/*.key
**/*.log
**/*migration*/**
**/*private*/**

!packages/
!packages/server/
!packages/server/package.json
!packages/server/tsconfig.json
!packages/server/src/
!packages/server/src/**/*.ts
!packages/server/src/openapi.json
!packages/server/test/
!packages/server/test/*.ts
!packages/dashboard/
!packages/dashboard/package.json
!packages/dashboard/tsconfig.json
!packages/dashboard/vite.config.ts
!packages/dashboard/index.html
!packages/dashboard/src/
!packages/dashboard/src/**
**/node_modules/**
**/dist/**
