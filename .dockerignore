# Deny by default: no repository history, host modules, health data or secrets.
**
!Dockerfile
!.dockerignore
!.gitignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!vite.config.ts
!README.md
!src/
!src/**/*.ts
!src/openapi.json
!test/
!test/*.ts
# Defense in depth if an allowlist is extended later.
**/node_modules/**
**/.git/**
**/.env
**/.env.*
**/data/**
**/*.sqlite*
**/*.db*
**/*.pem
**/*.key
**/*.log
**/*migration*/**
**/*private*/**

!packages/
!packages/dashboard/
!packages/dashboard/package.json
!packages/dashboard/tsconfig.json
!packages/dashboard/vite.config.ts
!packages/dashboard/index.html
!packages/dashboard/src/
!packages/dashboard/src/**
**/node_modules/**
**/dist/**
